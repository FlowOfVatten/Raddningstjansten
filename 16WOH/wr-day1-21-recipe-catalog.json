    "detailImage": "WR Måltider dag 1-21_augusti_files/image006.gif",
    "photoImage": "WR Måltider dag 1-21_augusti_files/image004.gif",
    "notes": "Partial transcript extracted manually from image006.",
    "transcript": {
      "servings": "2 maltider",
      "ingredients": [
        "2 handflatsstorlekar torskfile eller lax",
        "1 citron",
        "1 dl pressad vitlok",
        "2 tsk olivolja",
        "1 zucchini",
        "2 nangar blad broccoli",
        "1 dl naturell kokosyoghurt",
        "1 nypa fekta sesam"
      ],
      "seasoning": [
        "2 krm salt",
        "svartpeppar",
        "cayennepeppar",
        "paprikapulver"
      ],
      "steps": [
        "Forvarm ugnen till 220 C.",
        "Hall oljan i en ugnsfast form. Lagg i fisken i formen.",
        "Pressa eller riv vitlok over fisken. Krydda med salt, svartpeppar och chiliflakes.",
        "Fortsatt tillaga i ugnen i cirka 10-15 minuter.",
        "Gor nu broccolipuren.",
        "Koka eller stromkoka broccoli mjuk. Lagg i mixer tillsammans med yoghurt och kryddor och mixa till puree."
      ]
    }
  },

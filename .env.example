# Trafiklab API key for live GTFS-RT data. If not set, falls back to simulator.
# Register at https://www.trafiklab.se/ to get one.
TRAFIKLAB_KEY=

# Preferred key name for GTFS Regional Realtime.
TRAFIKLAB_RT_KEY=

# Optional static data key.
TRAFIKLAB_STATIC_KEY=

# Path to an extracted GTFS static folder containing routes.txt, trips.txt,
# stop_times.txt and stops.txt. If set, the server auto-builds the network from
# those files at startup.
GTFS_STATIC_DIR=

# Which lines to import from the GTFS static folder.
STATIC_GTFS_LINES=120,125

# GTFS Realtime feed URLs (paste your UL regional endpoints here).
# Keep empty to use built-in defaults.
GTFS_RT_VEHICLE_URL=
GTFS_RT_TRIPS_URL=
GTFS_RT_ALERTS_URL=

# Segment matching distance in meters (increase for sparse rural bus routes).
GTFS_MAX_MATCH_METERS=1200

# Optional: set to 1 to enable live GTFS source.
# Default behavior in this branch is simulator mode for the Alunda bus setup.
ENABLE_LIVE_GTFS=0

# OpenRouter API key for AI traffic analyst.
# Register at https://openrouter.ai/ to get one.
# If not set, the AI panel is disabled.
OPENROUTER_KEY=

# How often the AI analyst runs, in milliseconds. Defaults to 90000 (90 s).
AI_INTERVAL_MS=90000

# Backend port. Defaults to 4000. The Vite dev proxy expects this.
PORT=4000

npm --prefix server run dev
